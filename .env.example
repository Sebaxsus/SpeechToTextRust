# Plantilla de configuración — copiar a `.env` (mismo directorio, junto a Cargo.toml) y
# descomentar/editar solo lo que necesites cambiar. Todas las líneas están comentadas mostrando
# el valor por defecto real: si no creás ningún `.env`, o dejás una variable comentada, el
# comportamiento es idéntico al de un checkout limpio del proyecto.
#
# Ver docs/configuracion.md para el detalle completo: qué controla cada variable y en qué
# archivo:línea del código se lee. `.env` nunca se commitea (ver .gitignore) — este archivo
# `.env.example` sí, es la plantilla pública.

# ============================================================================
# Rutas
# ============================================================================

# Directorio donde se crea una carpeta por job (./jobs/{job_id}/audio.*, transcript.jsonl, etc.).
# JOBS_DIR=./jobs

# Directorio de los logs rotados diariamente (ver docs/Arquitechture.md: "Observabilidad y
# operación").
# LOGS_DIR=./logs

# Ruta al modelo GGML de Whisper (ver README.md, sección "Instalación" — descargar
# ggml-small-q5_1.bin).
# WHISPER_MODEL_PATH=models/ggml-small-q5_1.bin

# Nombre/ruta del binario de ffmpeg/ffprobe — cambiar solo si no están en el PATH del sistema y
# preferís apuntar a una ruta absoluta en vez de agregarlos al PATH.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# ============================================================================
# Servicios (Ollama / Qdrant / bind del servidor)
# ============================================================================

# Host de Ollama — tiene que ser una URL completa (con esquema), no un hostname suelto.
# OLLAMA_HOST=http://127.0.0.1
# OLLAMA_PORT=11434

# URL de Qdrant (gRPC). Ver CLAUDE.local.md: Qdrant nunca se expone en la LAN, solo loopback.
# QDRANT_URL=http://localhost:6334

# Dirección/puerto donde escucha el servidor Axum.
# SERVER_BIND_ADDR=0.0.0.0:3000

# Token bearer para /mcp y los endpoints REST protegidos (GET /api/jobs/*, POST /api/search,
# POST /api/rag/answer). Sin esta variable, esas rutas quedan SIN autenticación — aceptable solo
# mientras el servidor no se expone más allá de localhost (ver CLAUDE.local.md: Fase 6).
# MCP_BEARER_TOKEN=

# ============================================================================
# Whisper — ¡CUIDADO! (ver CLAUDE.local.md antes de tocar esta sección)
# ============================================================================
# Estos valores fueron afinados junto con el fix del bug de alucinación "(Portuguesa)"
# (2026-07-31) — trabajan en conjunto, no de forma aislada (ej. suppress_nst + los thresholds de
# logprob/no_speech). Cambiarlos puede degradar la PRECISIÓN de la transcripción, que es la
# prioridad #1 de este proyecto (por delante de estabilidad y velocidad). No los toques salvo que
# sepas exactamente qué estás midiendo y por qué.

# WHISPER_ENTROPY_THOLD=2.3
# WHISPER_SUPPRESS_BLANK=true
# WHISPER_SUPPRESS_NST=true
# WHISPER_TEMPERATURE=0.0
# WHISPER_TEMPERATURE_INC=0.1
# WHISPER_LOGPROB_THOLD=-0.8
# WHISPER_NO_SPEECH_THOLD=0.5
# WHISPER_SINGLE_SEGMENT=false
# WHISPER_TOKEN_TIMESTAMPS=false
# WHISPER_SPLIT_ON_WORD=true
# WHISPER_N_THREADS=8
# WHISPER_INITIAL_PROMPT=Transcripción de una reunión de trabajo en español, conversación natural.

# ============================================================================
# Chunking — igual de sensible: ver "Context Aware Chunking" en CLAUDE.local.md
# ============================================================================
# CHUNK_SECONDS/OVERLAP_SECONDS tienen que producir un número de samples múltiplo exacto del hop
# de 10ms de Whisper (@ 16kHz) — el servidor rechaza arrancar (con un mensaje explícito) si no lo
# son, en vez de aceptar un chunking mal alineado en silencio.

# CHUNK_SECONDS=30
# OVERLAP_SECONDS=2
# RESAMPLER_CHUNK_SIZE=1024

# ============================================================================
# RAG — modelos y parámetros de retrieval/generación/resumen
# ============================================================================

# RAG_EMBEDDING_MODEL=bge-m3
# RAG_GENERATION_MODEL=qcwind/qwen2.5-7b-instruct-Q4_K_M:latest
# RAG_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
# RAG_RERANKER_REVISION=main

# Top-k de rag_answer (5-8 recomendado, ver CLAUDE.local.md).
# RAG_TOP_K=6
# Top-k de un retrieval crudo (search_transcript / POST /api/search) — más generoso porque el
# caller ve los chunks tal cual.
# RAG_SEARCH_TOP_K=8
# Pool de candidatos que trae el bi-encoder antes de que el reranker reordene (solo scope
# all_corpus).
# RAG_RERANK_CANDIDATE_POOL=30
# Umbral de avg_logprob por debajo del cual un chunk se marca low_confidence / [BAJA CONFIANZA].
# RAG_LOW_CONFIDENCE_THOLD=-0.6
# num_ctx de la llamada de rag_answer a Ollama.
# RAG_ANSWER_NUM_CTX=4096

# Resumen por audio (map-reduce por lotes, ver CLAUDE.local.md: "Resumen por audio").
# RAG_SUMMARY_BATCH_MAX_CHUNKS=50
# RAG_SUMMARY_BATCH_MAX_CHARS=12000
# RAG_SUMMARY_BATCH_NUM_CTX=8192
# RAG_SUMMARY_BATCH_NUM_PREDICT=300
# RAG_SUMMARY_CONSOLIDATION_NUM_PREDICT=500

# Duración máxima (segundos) de un clip pedido a GET /api/jobs/{job_id}/audio-segment.
# MAX_SEGMENT_SECONDS=120
